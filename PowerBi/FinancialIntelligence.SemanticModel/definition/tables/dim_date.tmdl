/// ET calendar 2024-2030 (curated.dim_date). Marked as the model's date table.
table dim_date
	dataCategory: Time

	column date_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: date_key

	column full_date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: full_date

	column year_num
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year_num

	column quarter_num
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: quarter_num

	column month_num
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: month_num

	column month_name
		dataType: string
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month_num

	column day_of_month
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: day_of_month

	column day_of_week
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: day_of_week

	column day_name
		dataType: string
		summarizeBy: none
		sourceColumn: day_name
		sortByColumn: day_of_week

	column is_weekend
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: is_weekend

	column Quarter = "Q" & dim_date[quarter_num]
		dataType: string
		summarizeBy: none
		sortByColumn: quarter_num

	column 'Year Month Key' = dim_date[year_num] * 100 + dim_date[month_num]
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none

	column 'Year Month' = FORMAT ( dim_date[full_date], "mmm yyyy" )
		dataType: string
		summarizeBy: none
		sortByColumn: 'Year Month Key'

	hierarchy 'Date Hierarchy'

		level Year
			column: year_num

		level Quarter
			column: Quarter

		level Month
			column: month_name

		level Day
			column: full_date

	partition dim_date = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    Data = Source{[Schema = "curated", Item = "dim_date"]}[Data],
				    Typed = Table.TransformColumnTypes(Data, {
				        {"date_key", Int64.Type}, {"full_date", type date}, {"year_num", Int64.Type},
				        {"quarter_num", Int64.Type}, {"month_num", Int64.Type}, {"month_name", type text},
				        {"day_of_month", Int64.Type}, {"day_of_week", Int64.Type}, {"day_name", type text},
				        {"is_weekend", type logical}})
				in
				    Typed

